# Đường dẫn gốc của API. Giữ nguyên /api/v1 để đi qua proxy của Vite.
VITE_API_BASE_URL=/api/v1

# true  → dùng MSW mock, chạy được HOÀN TOÀN không cần backend.
#         Đăng nhập bằng email bất kỳ; email chứa "agent" sẽ vào vai IT Agent.
# false → gọi backend thật qua proxy bên dưới.
VITE_USE_MOCK=true

# Backend thật nằm ở đâu (chỉ dùng khi VITE_USE_MOCK=false).
# Đổi ở đây thay vì sửa vite.config.ts — sửa file cấu hình chung để chạy được
# máy mình là cách nhanh nhất tạo ra commit làm hỏng máy người khác.
VITE_API_PROXY_TARGET=http://localhost:8000
