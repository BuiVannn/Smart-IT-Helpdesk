# ── Môi trường ──
ENVIRONMENT=local                     # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev_password
POSTGRES_DB=helpdesk
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk_dev_password@postgres:5432/helpdesk

# ── Redis ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Bảo mật ──
# Sinh chuỗi thật bằng: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_dev_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Object storage (MinIO ở local, S3 ở production) ──
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=helpdesk-attachments
S3_REGION=us-east-1

# ── AI ──
LLM_PROVIDER=fake                     # fake | openai  (fake = không cần API key)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AI_MONTHLY_BUDGET_USD=20
AI_CONFIDENCE_THRESHOLD=0.6
RAG_SIMILARITY_THRESHOLD=0.35
RAG_TOP_K=8

# ── SLA ──
BUSINESS_HOUR_START=8.5               # 8:30
BUSINESS_HOUR_END=17.5                # 17:30
