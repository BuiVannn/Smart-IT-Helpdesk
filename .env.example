# ── Môi trường ──
ENVIRONMENT=local                     # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_dev_password
POSTGRES_DB=helpdesk
# Nếu máy bạn đã có PostgreSQL chạy sẵn (Homebrew, Postgres.app...), cổng 5432
# sẽ bị chiếm và container không kết nối được. Đổi sang cổng trống, ví dụ 5434.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk_dev_password@postgres:5432/helpdesk

# ── Redis ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Bảo mật ──
# Sinh chuỗi thật bằng: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_dev_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Object storage (MinIO ở local, S3 ở production) ──
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=helpdesk-attachments
S3_REGION=us-east-1

# ── AI ─────────────────────────────────────────────────────────────────
#
# `openai` KHÔNG có nghĩa là phải dùng OpenAI — nó nghĩa là "HTTP API theo
# chuẩn OpenAI". Ollama Cloud, OpenRouter, Groq, Together, Azure và Ollama
# chạy máy đều nói chuẩn này; chỉ khác LLM_BASE_URL.
#
# Kiểm tra cấu hình bằng:  python scripts/check_llm.py --models
#
LLM_PROVIDER=fake                     # fake | openai  (fake = không cần API key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_JSON_MODE=json_object             # json_schema | json_object | none
                                      # json_schema là đặc sản OpenAI; phần lớn
                                      # model mở chỉ hiểu json_object

# ── Nhà cung cấp DỰ PHÒNG (điền khoá là tự bật) ────────────────────────
#
# Cần vì hạn mức miễn phí không ổn định theo bản chất: Ollama Cloud tính theo
# thời gian GPU và reset theo phiên 5 giờ; OpenRouter gỡ model `:free` liên
# tục (7/2026 rút 20 xuống 15 endpoint trong chín ngày, xoá hẳn tầng Llama và
# Qwen). Một nhà cung cấp duy nhất nghĩa là sẽ có ngày demo không chạy.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ── Embedding ──────────────────────────────────────────────────────────
#
# ★ PHẢI CẤU HÌNH RIÊNG NẾU DÙNG OLLAMA CLOUD: Ollama Cloud KHÔNG có model
# embedding nào (lọc cloud+embedding trên ollama.com trả về rỗng). Để trống
# hai dòng dưới thì hệ thống dùng lại cấu hình LLM ở trên.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536             # PHẢI khớp số chiều thật của model;
                                      # cột article_chunks.embedding là vector(N)

AI_MONTHLY_BUDGET_USD=20
AI_CONFIDENCE_THRESHOLD=0.6
RAG_SIMILARITY_THRESHOLD=0.35
RAG_TOP_K=8

# ── CẤU HÌNH KHUYẾN NGHỊ: Ollama Cloud (chính) + OpenRouter (dự phòng) ──
#
# Khoá Ollama Cloud:  https://ollama.com/settings/keys   (miễn phí, không cần thẻ)
# Khoá OpenRouter:    https://openrouter.ai/keys         (miễn phí, không cần thẻ)
#
# Bỏ dấu # ở các dòng dưới, và LẤY TÊN MODEL BẰNG LỆNH
#   python scripts/check_llm.py --models
# thay vì chép cứng — danh sách model free thay đổi hằng tuần.
#
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://ollama.com/v1          # KHÔNG phải api.ollama.com (301)
# LLM_API_KEY=<khoá Ollama Cloud>
# LLM_MODEL=<tên lấy từ --models, ví dụ qwen3.5 hoặc gpt-oss>
# LLM_JSON_MODE=json_object
#
# LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# LLM_FALLBACK_API_KEY=<khoá OpenRouter>
# LLM_FALLBACK_MODEL=<tên lấy từ --models, ví dụ ...:free>
#
# # Ollama Cloud không có embedding ⇒ trỏ sang OpenRouter
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=<khoá OpenRouter>
# EMBEDDING_MODEL=openai/text-embedding-3-small
#
# SAU KHI ĐỔI: bắt buộc chạy `python scripts/reindex_kb.py --all`
# Vector của hai model khác nhau không so sánh được; Retriever lọc chunk theo
# embedding_model nên nếu quên, chatbot sẽ trả lời "không tìm thấy tài liệu".

# ── SLA ──
BUSINESS_HOUR_START=8.5               # 8:30
BUSINESS_HOUR_END=17.5                # 17:30
